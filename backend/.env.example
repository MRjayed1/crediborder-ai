# ============================================================================
# CREDIBORDER AI — BACKEND ENVIRONMENT VARIABLES (.env)
# ============================================================================
PORT=4000

# 1. FREE LLM API KEYS (Zero credit card / wallet required!)
# Option A (Recommended for Speed): Get free key at https://console.groq.com/keys
GROQ_API_KEY=your_free_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Option B (Alternative Free Key): Get free key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_free_gemini_api_key_here

# 2. SUPABASE CONNECTION (Get from Supabase Project Settings -> API)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# 3. OPTIONAL ETHEREUM SEPOLIA TESTNET RPC (For +5 Challenge Bonus)
# If omitted, the backend uses deterministic EIP-712 cryptographic signing & sandbox hash generation
SEPOLIA_RPC_URL=https://rpc.sepolia.org
SEPOLIA_PRIVATE_KEY=
